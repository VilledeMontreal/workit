{
  "name": "root",
  "private": true,
  "scripts": {
    "postinstall": "lerna run genPackagelock",
    "fix": "lerna run fix",
    "predocs-test": "npm docs",
    "docs-test": "lerna run docs-test",
    "docs": "lerna run docs",
    "build": "lerna run build",
    "lint-fix": "lerna run lint-fix",
    "lint": "lerna run lint",
    "test": "lerna run test",
    "test:all": "lerna run test:all",
    "test:integration": "lerna run test:integration --scope=workit",
    "clean": "lerna clean -y",
    "remark-lint": "remark ."
  },
  "devDependencies": {
    "@types/node": "^20.19.27",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lerna": "^9.0.3",
    "lerna-changelog": "^2.2.0",
    "remark-cli": "^12.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "typescript": "^4.9.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lerna run lint-fix && remark .",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-push": "lerna exec npm run test"
    }
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-lint-recommended"
    ]
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "workspaces": [
    "./examples/basic",
    "./examples/binding",
    "./examples/event",
    "./examples/failure-strategy",
    "./examples/opentelemetry",
    "./examples/parallel",
    "./examples/plugin-metrics",
    "./packages/workit",
    "./packages/workit-bpm-client",
    "./packages/workit-stepfunction-client",
    "./packages/workit-core",
    "./packages/workit-types"
  ],
  "version": "6.0.1"
}
