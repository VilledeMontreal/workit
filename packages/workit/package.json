{
  "name": "@villedemontreal/workit",
  "version": "7.0.3",
  "description": "Worker for Node.js system with pluggable clients that works with both AWS Step function and Camunda platform powered by TypeScript",
  "author": "Montreal City Authors",
  "homepage": "https://github.com/VilledeMontreal/workit#readme",
  "license": "MIT",
  "main": "lib/src/index.js",
  "typings": "lib/src/index.d.ts",
  "dependencies": {
    "@villedemontreal/workit-bpm-client": "^7.0.3",
    "@villedemontreal/workit-core": "^7.0.3",
    "@villedemontreal/workit-stepfunction-client": "^7.0.3",
    "@villedemontreal/workit-types": "^7.0.3",
    "debug": "~4.4.3",
    "inversify": "7.10.4",
    "reflect-metadata": "~0.2.2"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.2.0",
    "@types/debug": "~4.1.13",
    "@types/events": "~3.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "axios": "^1.19.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "test": "jest --testPathIgnorePatterns integration --coverage",
    "test:all": "jest --coverage",
    "clean": "rm -rf ./lib/",
    "compile": "rm -rf ./lib/ && npm run build",
    "build": "tsc -p ./tsconfig.json",
    "watch": "tsc -p ./tsconfig.json --watch",
    "lint": "eslint . --ext .ts && prettier -l \"src/**/*.ts\"",
    "lint-fix": "prettier \"./**/*.ts\" --write && eslint . --ext .ts --fix",
    "check-conflicts": "eslint --print-config tests/utils/func-test.ts | eslint-config-prettier-check",
    "docs": "typedoc --out ./docs --tsconfig ./tsconfig.json --excludePrivate"
  },
  "keywords": [
    "Ville de Montreal",
    "Typescript",
    "Camunda",
    "Stepfunction",
    "open-telemetry",
    "Worker"
  ],
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib/src/**/*.js",
    "lib/src/**/*.d.ts",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VilledeMontreal/workit.git",
    "directory": "packages/workit"
  },
  "bugs": {
    "url": "https://github.com/VilledeMontreal/workit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
