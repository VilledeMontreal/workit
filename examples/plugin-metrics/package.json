{
  "name": "workit-example-plugin-metrics",
  "private": true,
  "version": "7.0.2",
  "description": "WorkIt plugin metrics example",
  "main": "lib/src/worker.js",
  "types": "lib/src/worker.d.ts",
  "scripts": {
    "clean": "rm -rf ./lib/",
    "compile": "rm -rf ./lib/ && npm run build",
    "build": "tsc -p ./tsconfig.json",
    "lint": "eslint . --ext .ts && prettier -l \"src/**/*.ts\"",
    "lint-fix": "prettier \"./**/*.ts\" --write && eslint . --ext .ts --fix",
    "start:camunda": "node lib/src/worker.js camunda",
    "start:stepfunction": "node lib/src/worker.js stepfunction",
    "create-instances:camunda": "node lib/src/create-process-instances.js camunda",
    "create-instances:stepfunction": "node lib/src/create-process-instances.js stepfunction",
    "deploy:camunda": "node lib/src/deploy.js camunda",
    "deploy:stepfunction": "node lib/src/deploy.js stepfunction",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@villedemontreal/workit": "^7.0.2",
    "@villedemontreal/workit-bpm-client": "^7.0.2",
    "@villedemontreal/workit-core": "^7.0.2",
    "@villedemontreal/workit-stepfunction-client": "^7.0.2",
    "@villedemontreal/workit-types": "^7.0.2",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "inversify": "^7.10.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "author": "Ville de Montreal",
  "license": "MIT",
  "keywords": [
    "workit",
    "plugin",
    "metrics",
    "monitoring",
    "camunda",
    "stepfunctions",
    "workflow"
  ]
}
