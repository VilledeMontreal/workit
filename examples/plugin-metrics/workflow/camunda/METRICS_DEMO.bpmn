  <bpmn:process id="METRICS_DEMO" name="Metrics Demo Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Start">
      <bpmn:outgoing>SequenceFlow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="SequenceFlow_1" sourceRef="StartEvent" targetRef="CalculateTask" />
    <bpmn:serviceTask id="CalculateTask" name="Calculate Numbers" camunda:type="external" camunda:topic="CalculateTask">
      <bpmn:incoming>SequenceFlow_1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_2</bpmn:outgoing>
